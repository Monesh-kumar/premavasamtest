# ==============================================================================
# PREMA VASAM WEB SERVER • ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production domain values
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Server Listen Port
PORT=3000

# Production Domain / CORS Whitelist
# Set this to your live domain (e.g., https://premavasam.org or https://www.yourdomain.com)
CORS_ORIGIN=https://premavasam.org

# Admin Portal Credentials
# ALWAYS change these before hosting on a public domain
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassphrase2026!
ADMIN_NAME="Premavasam Administrator"
ADMIN_EMAIL="premavasam1999@gmail.com"
ADMIN_ROLE="Superadmin"

# Session Expiration (in hours, default 4)
SESSION_TTL_HOURS=4
