# ==============================================================================
# PREMA VASAM WEB SERVER • ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production values
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Server Listen Port
PORT=3000

# Production Domain / CORS Whitelist (Strictly set to your exact domain)
CORS_ORIGIN=https://premavasam.org

# Admin Portal Credentials
# ALWAYS set strong, unique credentials before hosting on a public domain
ADMIN_USER=premavasam_admin
ADMIN_PASSWORD=ChangeThisToAStrongPassphrase2026!
ADMIN_NAME="Premavasam Administrator"
ADMIN_EMAIL="premavasam1999@gmail.com"
ADMIN_ROLE="Superadmin"

# Native AES-256-GCM Encryption Key for Donor PAN Information
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Reverse Proxy Trust Configuration (DigitalOcean Nginx / Cloudflare)
# Set to true only when behind an authentic reverse proxy that sets X-Forwarded-For
TRUST_PROXY=true
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# Session Expiration (in hours, default 4)
SESSION_TTL_HOURS=4
