# ══════════════════════════════════════════════════════════════════════
# PREMA VASAM • DigitalOcean Apache VirtualHost Configuration
# Production Hardened • Reverse Proxy to Node.js • SSL & Defensive Headers
# ══════════════════════════════════════════════════════════════════════
# Place in: /etc/apache2/sites-available/premavasam.conf
#
# Enable required modules:
#   sudo a2enmod proxy proxy_http rewrite headers deflate expires ssl
#   sudo a2ensite premavasam.conf
#   sudo apache2ctl configtest && sudo systemctl reload apache2
# ══════════════════════════════════════════════════════════════════════

# 1. HTTP Server Block (Redirect to HTTPS)
<VirtualHost *:80>
    ServerName premavasam.org
    ServerAlias www.premavasam.org

    # Allow Let's Encrypt Certbot ACME Challenges
    DocumentRoot /var/www/premavasam

    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://www.premavasam.org/$1 [L,R=301]
</VirtualHost>

# 2. HTTPS Server Block (SSL & Reverse Proxy)
<VirtualHost *:443>
    ServerName premavasam.org
    ServerAlias www.premavasam.org
    DocumentRoot /var/www/premavasam

    # Canonical WWW enforcement
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^premavasam\.org$ [NC]
    RewriteRule ^(.*)$ https://www.premavasam.org/$1 [L,R=301]

    # SSL Configuration (Managed automatically by certbot)
    SSLEngine on
    # SSLCertificateFile /etc/letsencrypt/live/premavasam.org/fullchain.pem
    # SSLCertificateKeyFile /etc/letsencrypt/live/premavasam.org/privkey.pem
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite HIGH:!aNULL:!MD5:!3DES

    # Defensive Security Headers
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Pass Real Client IP and Protocol to Node.js
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Real-IP %{REMOTE_ADDR}s

    # Reverse Proxy /api directly to local Node.js process (Port 3000)
    ProxyPass /api http://127.0.0.1:3000/api
    ProxyPassReverse /api http://127.0.0.1:3000/api

    # Clean URL routing for web pages (e.g. /admin -> /admin.html)
    <Directory /var/www/premavasam>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Block sensitive files from web access
    <FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|env|json|lock|md|log|yml|yaml|dockerignore|conf|example|bak|sh|sql|ini)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^(server\.js|backup\.js|security_audit_test\.js|test_runner\.js|test_suite\.js|ecosystem\.config\.js|Dockerfile|docker-compose\.yml)$">
        Require all denied
    </FilesMatch>

    # Logging
    ErrorLog ${APACHE_LOG_DIR}/premavasam_error.log
    CustomLog ${APACHE_LOG_DIR}/premavasam_access.log combined
</VirtualHost>
